---
import type { ItemGrid as Props } from '~/types';
import { twMerge } from 'tailwind-merge';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

// Minimal component type for SVGs
type IconComponent = (props: { class?: string }) => unknown;

// Props from parent
const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props;

// Tailwind class overrides
const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'aw-color-primary',
  action: actionClass = '',
} = classes;

// === Import skill-icn SVGs for skillsicon support ===
const SkillIcons = import.meta.glob('../../assets/images/skill-icn/*.svg', { eager: true });

// Helper: turn "path/to/sharepoint.svg" → "sharepoint"
function makeKey(path: string): string {
  return (path.split('/').pop() ?? '').replace('.svg', '');
}

// Build a lookup map
const skillIconMap: Record<string, IconComponent> = {};

for (const [path, mod] of Object.entries(SkillIcons)) {
  const typedMod = mod as { default: IconComponent };
  skillIconMap[makeKey(path)] = typedMod.default;
}
---

{
  items && items.length > 0 && (
    <div
      class={twMerge(
        `grid mx-auto gap-8 md:gap-y-12 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map((item) => {
        const { title, description, icon, skillsicon, callToAction, classes: itemClasses = {}, link, image } = item;

        // If a `skillsicon` key is provided, look up the SVG component
        const CustomIcon = skillsicon ? skillIconMap[skillsicon] : null;
        const IconComp = CustomIcon as IconComponent | null;

        // Wrap panel in <a> if a link is provided (makes whole card clickable)
        const PanelWrapper = link ? 'a' : 'div';

        return (
          <div class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <PanelWrapper
              href={link}
              target={link ? '_blank' : undefined}
              rel={link ? 'noopener noreferrer' : undefined}
              class={twMerge('flex flex-row items-center max-w-md', panelClass, itemClasses?.panel)}
            >
              {/* === ICON AREA === */}
              {(IconComp || icon || defaultIcon) && (
                <div class="flex items-center justify-center mr-1 rtl:ml-1 rtl:mr-0">
                  <div
                    class={twMerge(
                      'flex items-center justify-center text-white bg-primary rounded-full w-10 h-10 md:w-12 md:h-12 opacity-90',
                      defaultIconClass,
                      itemClasses?.icon
                    )}
                  >
                    {IconComp ? (
                      <IconComp class="w-5 h-5 md:w-6 md:h-6" />
                    ) : (
                      <Icon name={icon || defaultIcon} class="w-5 h-5 md:w-6 md:h-6" />
                    )}
                  </div>
                </div>
              )}

              {/* === TEXT AREA === */}
              <div class="flex flex-col">
                {title && <h3 class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>{title}</h3>}

                {description && (
                  <p
                    class={twMerge(`${title ? 'mt-3' : ''} text-muted`, descriptionClass, itemClasses?.description)}
                    set:html={description}
                  />
                )}

                {image && <img src={image} alt={title} class="mt-4 w-full h-40 rounded-lg shadow-md object-cover" />}

                {callToAction && (
                  <div class={twMerge(`${title || description ? 'mt-3' : ''}`, actionClass, itemClasses?.actionClass)}>
                    <Button variant="link" {...callToAction} />
                  </div>
                )}
              </div>
            </PanelWrapper>
          </div>
        );
      })}
    </div>
  )
}
