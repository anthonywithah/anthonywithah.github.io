---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import profilePic from '~/assets/images/a-p-25-sml.jpg'; // EDIT

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
  external?: boolean;
}
interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  showDesktopNav?: boolean; // EDIT
  showDesktop?: boolean; // EDIT
  socialLinks?: Array<Link>; // EDIT
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  position = 'center',
  showDesktopNav = true, // EDIT
  showDesktop = true, // EDIT
  socialLinks = [], // EDIT
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  class:list={[
    // hide header on desktop if showDesktop === false
    { 'md:hidden': !showDesktop },
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      { 'md:ml-64': true }, // EDIT: shift content right on desktop
      { 'md:flex md:justify-between': position !== 'center' },
      { 'md:grid md:grid-cols-3 md:items-center': position === 'center' },
      { 'max-w-7xl': !isFullWidth },
    ]}
  >
    <div class="flex justify-between">
      <a href={getHomePermalink()} class="flex items-center">
        <Logo />
        <span class="ml-2 text-sm text-gray-500 dark:text-gray-400">
          SharePoint/Microsoft 365<br />and Digital Solutions Specialist
        </span>
      </a>

      <!-- Burger button + mobile nav wrapper -->
      <div class="flex items-center md:hidden group relative">
        <ToggleMenu />

        <nav
          class="hidden group-[.expanded]:block absolute top-full left-0 w-screen bg-white dark:bg-[#020414] shadow-md"
          aria-label="Mobile navigation"
        >
          <ul class="flex flex-col divide-y divide-gray-200 dark:divide-gray-700">
            {
              links.map(({ text, href, icon, external }) => (
                <li>
                  {href ? (
                    <a
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class="flex items-center px-4 py-3 text-muted hover:bg-gray-100 dark:hover:bg-gray-800"
                    >
                      {icon && <Icon name={icon} class="w-5 h-5 mr-2" />}
                      {text}
                    </a>
                  ) : (
                    <span class="flex items-center px-4 py-3 text-muted cursor-default">
                      {icon && <Icon name={icon} class="w-5 h-5 mr-2" />}
                      {text}
                    </span>
                  )}
                </li>
              ))
            }
          </ul>

          <!-- Social footer -->
          {
            socialLinks?.length > 0 && (
              <div class="flex justify-center gap-4 py-4 border-t border-gray-200 dark:border-gray-700">
                {socialLinks.map(({ ariaLabel, href, icon }) => (
                  <a aria-label={ariaLabel} href={href} class="text-muted dark:text-gray-400 hover:text-link">
                    {icon && <Icon name={icon} class="w-6 h-6" />}
                  </a>
                ))}
              </div>
            )
          }

          <!-- Profile image at bottom -->
          <div class="flex justify-center py-6 border-t border-gray-200 dark:border-gray-700">
            <img src={profilePic.src} alt="My profile" class="w-32 h-32 rounded-full object-cover" />
          </div>
        </nav>
      </div>
    </div>

    {
      showDesktopNav && (
        <nav class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default" aria-label="Main navigation">
          <ul class="flex flex-col md:flex-row w-full md:w-auto text-xl md:text-sm font-medium md:justify-center">
            {links.map(({ text, href, icon, external }) => (
              <li>
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  {icon && <Icon name={icon} class="w-4 h-4 mr-2" />} {/* EDIT */}
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="hidden md:flex items-center justify-end">
      {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5" />}
      {
        actions?.length
          ? actions.map((btnProps) => <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold text-sm" />)
          : null
      }
    </div>
  </div>
</header>
