---
import { Icon } from 'astro-icon/components';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import Button from '~/components/ui/Button.astro';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';
import Logo from '~/components/Logo.astro';
import profilePic from '~/assets/images/a-p-25-sml.jpg';

import type { MenuLink } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  showToggleTheme?: boolean;
  socialLinks?: Array<Link>;
}

const { id = 'sidebar', links = [], actions = [], showToggleTheme = false, socialLinks = [] } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<!-- Desktop sidebar only -->
<aside id={id} class="hidden md:flex fixed top-0 left-0 w-64 flex-col bg-white dark:bg-[#020414] z-30 h-screen">
  <!-- Profile image (centered at top) -->
  <div class="mt-8 mb-6 flex-shrink-0 flex justify-center">
    <a href="/" aria-label="Home">
      <img
        src={profilePic.src}
        alt="My profile"
        class="w-32 h-32 rounded-full object-cover hover:opacity-90 transition"
      />
    </a>
  </div>

  <div class="w-full px-4 mb-6">
    <div class="flex flex-col items-start px-4 sidebar-logo-block">
      <a href="/" aria-label="Home">
        <Logo class="h-8 w-auto" />
      </a>
      <p class="hidden md:block mt-1 text-sm text-gray-500 dark:text-gray-400">
        SharePoint/Microsoft 365<br />and Digital Solutions Specialist
      </p>
    </div>
  </div>

  <style>
    .sidebar-logo-block :global(.ml-2) {
      margin-left: 0 !important;
    }
    .sidebar-logo-block :global(.rtl\:ml-0) {
      margin-left: 0 !important;
    }
    .sidebar-logo-block :global(.rtl\:mr-2) {
      margin-right: 0 !important;
    }
  </style>

  <!-- Navigation links (left aligned) -->
  <nav class="flex-1 overflow-y-auto w-full px-4" aria-label="Desktop navigation">
    <!-- FONT SIZE -->
    <ul class="flex flex-col space-y-2 text-sm font-medium">
      {
        links.map(({ text, href, icon, external }) => (
          <li>
            <a
              class:list={[
                'flex items-center px-4 py-2 rounded text-muted',
                href
                  ? 'hover:bg-gray-100 dark:hover:bg-gray-800' // hover only if link
                  : 'cursor-default text-gray-500 dark:text-gray-400', // muted if no link
                { 'bg-gray-200 dark:bg-gray-700': href === currentPath }, // highlight active link
              ]}
              href={href ?? undefined}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              tabindex={href ? undefined : -1}
            >
              {icon && <Icon name={icon} class="w-5 h-5 mr-2" />}
              {text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Bottom controls (theme toggle, socials, actions, logo) -->
  <div class="mt-auto p-4 flex flex-col items-center space-y-3">
    <!-- Theme toggle button -->
    {showToggleTheme && <ToggleTheme iconClass="w-6 h-6" />}

    <!-- Social links -->
    {
      socialLinks.length > 0 && (
        <ul class="flex flex-wrap justify-center gap-2 w-full">
          {socialLinks.map(({ ariaLabel, href, icon }) => (
            <li>
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700
                     focus:outline-none focus:ring-2 focus:ring-gray-200 dark:focus:ring-gray-700
                     rounded-lg p-2 inline-flex items-center justify-center"
                aria-label={ariaLabel}
                href={href}
              >
                {icon && <Icon name={icon} class="w-5 h-5" />}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <!-- Action buttons (optional) -->
    {actions && actions.length > 0 ? actions.map((btnProps) => <Button {...btnProps} class="w-full" />) : null}
  </div>
</aside>
