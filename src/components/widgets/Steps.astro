---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  image, // single image
  images = [], // multiple images
  isReversed = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Normalize: always work with an array
const normalizedImages = images.length ? images : image ? [image] : [];
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl ${classes?.container ?? ''}`} bg={bg}>
  <div
    class:list={[
      'flex flex-col gap-8 md:gap-12',
      { 'md:flex-row-reverse': isReversed },
      { 'md:flex-row': normalizedImages.length },
    ]}
  >
    <!-- Left side: text + timeline -->
    <div
      class:list={[
        'md:py-4 md:self-center',
        { 'md:basis-1/2': normalizedImages.length },
        { 'w-full': !normalizedImages.length },
      ]}
    >
      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'text-left rtl:text-right',
          title: 'text-3xl lg:text-4xl',
          ...((classes?.headline as object) ?? {}),
        }}
      />
      <Timeline items={items} classes={classes?.items as Record<string, never>} />
    </div>

    <!-- Right side: one or many images -->
    {
      normalizedImages.length > 0 && (
        <div class="flex flex-col gap-4 md:basis-2/5">
          {normalizedImages.map((img: { src: string; alt?: string }) => (
            <Image
              class="object-cover w-full rounded-md shadow-lg bg-gray-400 dark:bg-slate-700"
              widths={[600, 800]}
              sizes="100vw"
              width={600}
              height={400}
              layout="cover"
              src={img.src}
              alt={img.alt || ''}
            />
          ))}
        </div>
      )
    }
  </div>
</WidgetWrapper>
