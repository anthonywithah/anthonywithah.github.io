---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import { Icon } from 'astro-icon/components'; // EDIT
import Features3 from '~/components/widgets/Features3.astro'; // EDIT
import step1 from '~/assets/images/step1.jpg';
import step2 from '~/assets/images/step2.jpg';
import step3 from '~/assets/images/step3.jpg';
import ContactUs from '~/components/widgets/Contact.astro';
import Badges from '~/components/ui/Badges.astro'; // EDIT

const metadata = {
  title: 'Anthony M.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="SharePoint/Microsoft 365 and Digital Solutions Specialist"
    image={{ src: '~/assets/images/hero-image.png', alt: 'AstroWind Hero Image' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Hello there, I'm Anthony</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span
        >Experienced IT and Business Management professional with 20+ years driving digital strategy and transformation.
        Trusted adviser delivering user-focused solutions that enhance collaboration, optimise workflows and boost
        productivity.</span
      >
    </Fragment>
  </Hero>

  <!-- Features3 Widget ************** -->

  <Features3
    id="skills"
    tagline="Tech Stack"
    title="My Core Skills"
    columns={3}
    isBeforeContent={true}
    items={[
      { title: 'SharePoint', skillsicon: 'sharepoint' },
      { title: 'Microsoft 365', skillsicon: 'microsoft365' },
      { title: 'PowerShell', skillsicon: 'powershell' },
      { title: 'Power Automate', skillsicon: 'powerautomate' },
      { title: 'JSON', skillsicon: 'json' },
      { title: 'Power Bi', skillsicon: 'powerbi' },
      { title: 'ShareGate', skillsicon: 'sharegate' },
      { title: 'HTML/CSS', skillsicon: 'htmlcss' },
      { title: 'Illustrator/PhotoShop', skillsicon: 'illustratorphotoshop' },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="How I can help your business"
    tagline="SOLUTIONS"
    items={[
      {
        title: 'Creative Solution Design',
        description: 'Analyse requirements and design tailored digital solutions',
        icon: 'fluent-color:lightbulb-filament-48',
      },
      {
        title: 'Development & Integration',
        description: 'Build and integrate custom applications and components',
        icon: 'fluent-color:code-block-48',
      },
      {
        title: 'Collaboration Tools',
        description: 'Enhance team productivity with collaboration strategies that work',
        icon: 'fluent-color:people-community-48',
      },
      {
        title: 'Automation & Workflows',
        description: 'Streamline business processes with automated workflows seamlessly',
        icon: 'fluent-color:arrow-clockwise-dashes-settings-48',
      },
      {
        title: 'Strategic Value',
        description: 'Align goals with core operations to drive efficiency and growth',
        icon: 'fluent-color:arrow-trending-lines-24',
      },
      {
        title: 'Communication Impact',
        description: 'Audit processes and improve communication to boost productivity',
        icon: 'fluent-color:chat-multiple-24',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Steps Widget ****************** -->
  <Steps
    tagline="CASE STUDY"
    title="SharePoint Client Portal"
    items={[
      {
        title: 'Step 1: Spot the Problem',
        description:
          'Clients faced scattered systems, siloed data and messy workflows that buried information and slowed collaboration.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Step 2: Define the Need',
        description:
          'A central, secure hub became essential to simplify access, streamline processes and strengthen communication.',
        icon: 'tabler:target',
      },
      {
        title: 'Step 3: Design the Solution',
        description:
          'I built a portal uniting storage, collaboration, dashboards and trackers into transparent, user‑friendly tools.',
        icon: 'tabler:tools',
      },
      {
        title: 'The Result',
        description:
          "Smoother teamwork, faster access and client relationships strengthened - backed by Microsoft's reliability & security.",
        icon: 'tabler:check',
      },
    ]}
    images={[
      { src: step1, alt: 'Step 1' },
      { src: step2, alt: 'Step 2' },
      { src: step3, alt: 'Step 3' },
    ]}
  >
    <Fragment slot="badges">
      <Badges
        items={[
          { label: 'SharePoint', color: 'bg-[#036C70]' },
          { label: 'Lists', color: 'bg-[#b92ebf]' },
          { label: 'Power BI', color: 'bg-[#b8860b]' },
          { label: 'Planner', color: 'bg-[#4373e5]' },
        ]}
      />
    </Fragment>
  </Steps>

  <!-- VIDEO ******************* -->

  <section id="video" class="pt-4 pb-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-4xl font-bold mb-4">See It in Action</h2>
      <div class="aspect-video rounded-lg overflow-hidden shadow-lg">
        <iframe
          class="w-full h-full"
          src="https://www.youtube.com/embed/dGhdkscV41Y?rel=0"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- More ******************* -->

  <Features
    id="more-about-me"
    tagline="About"
    title="More about me"
    columns={2}
    items={[
      {
        title: 'LinkedIn',
        description: 'Learn more about me - my experience, my skills, my education and more',
        image: '/images/linkedin.jpg',
        link: 'https://www.linkedin.com/in/anthonywithah',
      },
      {
        title: 'Consulting',
        description:
          'Setup consultancy for test trading and interim projects while between roles (consulting, training, tech support)',
        image: '/images/wbit.png',
        link: 'https://weirdbeardit.com',
      },
    ]}
  />

  <!-- Contact ******************* -->

  <ContactUs
    id="contact"
    tagline="CONTACT"
    title="Send me an email"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
  />

  <!-- Note Widget ******************* -->

  <Note title="">
    <div class="text-center">
      <span class="inline-flex items-center justify-center gap-2 text-sm">
        <img
          src="/images/awah-un-ro-0525.png"
          alt="My avatar"
          class="w-8 h-8 rounded-full border border-gray-300 dark:border-gray-600"
        />
        Designed and developed in Visual Studio Code by me. Built with Github, Astro & Tailwind.
      </span>
      <br />
      © 2025 Anthony M. All rights reserved.<br />
      <a
        href="https://github.com/anthonywithah/anthonywithah.github.io"
        target="_blank"
        class="inline-flex items-center gap-1 text-primary no-underline hover:underline dark:text-gray-400"
      >
        <Icon name="tabler:brand-github" class="w-4 h-4" />
        <span>Source Code</span>
      </a>
    </div>
  </Note>
</Layout>
